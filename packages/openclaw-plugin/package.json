{
    "name": "@prometheusavatar/openclaw-plugin",
    "version": "0.11.0",
    "description": "Prometheus for OpenClaw: connect a seller account and publish listings at the OpenClaw seller rate, AAA image generation for skin previews, and an avatar bridge. Ships with a bundled skill.",
    "type": "module",
    "main": "./dist/index.js",
    "license": "MIT",
    "files": [
        "dist",
        "src",
        "skills",
        "openclaw.plugin.json",
        "README.md",
        "tsconfig.json"
    ],
    "keywords": [
        "openclaw",
        "openclaw-plugin",
        "live2d",
        "avatar",
        "lip-sync",
        "tts",
        "emotion",
        "ai-agent",
        "image-generation",
        "marketplace",
        "seller"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/myths-labs/prometheus-avatar"
    },
    "author": "Myths Labs (JC)",
    "homepage": "https://prometheus.mythslabs.ai",
    "dependencies": {
        "@prometheusavatar/core": "^0.11.4"
    },
    "openclaw": {
        "compat": {
            "pluginApi": ">=2026.9.6"
        },
        "build": {
            "openclawVersion": "2026.9.6"
        },
        "extensions": [
            "./dist/index.js"
        ]
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --clean",
        "typecheck": "tsc --noEmit",
        "test": "tsup src/index.ts --format esm --clean && node --test test/*.test.mjs"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.4.0"
    }
}
