{
    "name": "@prometheusavatar/openclaw-plugin",
    "version": "0.10.3",
    "description": "Prometheus Avatar plugin for OpenClaw — a 2D avatar body (.model3.json) with TTS, lip-sync, emotion, plus AAA image generation for marketplace skin previews. Now ships with bundled Skill that teaches the agent when and how to use the 3 creator tools.",
    "type": "module",
    "main": "./dist/index.js",
    "license": "MIT",
    "files": [
        "dist",
        "src",
        "skills",
        "openclaw.plugin.json",
        "README.md",
        "tsconfig.json"
    ],
    "keywords": [
        "openclaw",
        "openclaw-plugin",
        "2d-avatar",
        "avatar",
        "lip-sync",
        "tts",
        "emotion",
        "ai-agent",
        "image-generation",
        "marketplace"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/myths-labs/prometheus-avatar"
    },
    "author": "Myths Labs (JC)",
    "homepage": "https://prometheus.mythslabs.ai",
    "dependencies": {
        "@prometheusavatar/core": "^0.11.3"
    },
    "openclaw": {
        "compat": {
            "pluginApi": ">=2026.3.23-1"
        },
        "build": {
            "openclawVersion": "2026.7.2"
        },
        "extensions": [
            "./dist/index.js"
        ]
    },
    "scripts": {
        "build": "tsup src/index.ts --format esm --clean"
    },
    "devDependencies": {
        "tsup": "^8.0.0"
    }
}
